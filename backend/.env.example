PORT=3000

# Ejemplos de conexión local; ajustar a la instalación real.
DB_HOST=127.0.0.1
DB_PORT=3306
# Completar manualmente con un usuario autorizado; no se asume root.
DB_USER=
# Colocar la contraseña real únicamente en .env, entre comillas si contiene #.
DB_PASSWORD=
DB_NAME=asistencia_paillardelle

# Completar localmente con un secreto aleatorio de al menos 32 bytes.
# No compartirlo ni reutilizar la contraseña de MySQL.
AUTH_JWT_SECRET=
AUTH_JWT_EXPIRES_IN_SECONDS=900
